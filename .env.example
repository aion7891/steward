# Steward environment configuration template.
# Copy this file to .env and fill in any values you need.
# Never commit .env to version control.

# Optional path to a custom configuration file
STEWARD_CONFIG_PATH=config.yaml

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
STEWARD_LOG_LEVEL=INFO

# Optional overrides. Leave these commented out to choose the model and dry-run on the
# Settings page; a value set here always wins and shows as "locked" in the web UI.
# STEWARD_MODEL_PROVIDER=ollama
# STEWARD_MODEL_ID=gemma4

# Local Ollama server URL (host runs Ollama natively on port 11434)
OLLAMA_HOST=http://localhost:11434

# Ollama URL reachable from inside Docker containers
DOCKER_OLLAMA_HOST=http://host.docker.internal:11434

# Safety override (true or false); also locks the dry-run switch in Settings
# STEWARD_DRY_RUN=true

# Cloud LLM API keys (only needed if switching away from Ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
